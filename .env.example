# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# The system runs without any of these: price and fundamental data come from
# yfinance, which needs no key. Only the LLM-written summaries require a key,
# and they fall back to templates when one is absent.

# Anthropic API — company profiles and news summaries
ANTHROPIC_API_KEY=

# Optional alternative data sources (not required by the backtests)
ALPHA_VANTAGE_KEY=
FMP_API_KEY=
FRED_API_KEY=

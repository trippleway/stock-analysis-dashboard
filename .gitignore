# ============================================================
# Git Ignore
# ============================================================

# ── Never push these to GitHub ────────────────────────────
.env
.env.*
*.key
*.pem
secrets.toml
credentials.json

# ── Python ──────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Virtual environments ──────────────────────────────────
venv/
env/
.venv/

# ── ML models ─────────────────────────────────────────────
*.safetensors
*.bin
*.pt
*.pth
~/.cache/huggingface/

# ── Large files ───────────────────────────────────────────
data/cache/
data/backtest_cache/
logs/
*.log

# ── Keep these ────────────────────────────────────────────
!data/daily_picks/*.json
!data/track_record/recommendations.csv

# ── System and IDE ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
!data/track_record/performance.json
!.env.example
build/

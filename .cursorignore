# ============================================================
# Cursor Ignore - 告訴 Cursor 哪些檔案不要索引
# ============================================================
# 說明：這些檔案不會被 Cursor Agent 或 Chat 讀取
#      主要用於保護敏感資料與提升索引效能

# ── 敏感檔案（絕對不能被 index）────────────────────────────
.env
.env.*
*.key
*.pem
secrets.toml
credentials.json

# ── 大型快取檔（避免拖慢索引）──────────────────────────────
data/cache/
data/track_record/*.csv
logs/
*.log

# ── Python 產物 ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 虛擬環境 ──────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── ML 模型檔（太大不索引）─────────────────────────────────
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.pkl
~/.cache/huggingface/

# ── 資料檔（保留結構但不索引內容）──────────────────────────
data/daily_picks/*.json
data/cache/**
data/backfill/**

# ── 系統與 IDE ────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Node（如果之後有）─────────────────────────────────────
node_modules/
package-lock.json

# ============================================================
# Cursor Ignore - files Cursor should not index
# ============================================================
# These files are not read by Cursor Agent or Chat.
# The main reasons are to protect sensitive data and to keep indexing fast.

# ── Sensitive files (must not be indexed) ─────────────────
.env
.env.*
*.key
*.pem
secrets.toml
credentials.json

# ── Large cache files (keep them out so indexing stays fast) ─
data/cache/
data/track_record/*.csv
logs/
*.log

# ── Python build output ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Virtual environments ──────────────────────────────────
venv/
env/
.venv/
.env/

# ── ML model files (too large to index) ───────────────────
*.safetensors
*.bin
*.pt
*.pth
*.h5
*.pkl
~/.cache/huggingface/

# ── Data files (keep the layout, do not index the contents) ─
data/daily_picks/*.json
data/cache/**
data/backfill/**

# ── System and IDE ────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Node (if it is added later) ───────────────────────────
node_modules/
package-lock.json
